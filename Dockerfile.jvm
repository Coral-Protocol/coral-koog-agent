FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace

COPY . .
RUN ./gradlew --no-daemon installDist -x test

# Build a custom minimal JRE to reduce runtime size
RUN jlink \
    --add-modules java.base,jdk.unsupported,java.desktop,java.instrument,java.logging,java.management,java.sql,java.xml,java.naming \
    --compress zip-6 --strip-debug --no-header-files --no-man-pages \
    --output /opt/minimal-java

FROM ubuntu:noble

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/opt/minimal-java
ENV PATH="$JAVA_HOME/bin:$PATH"

WORKDIR /app

COPY --from=build /opt/minimal-java /opt/minimal-java
# The Application plugin's installDir can vary with applicationName; use a wildcard to be robust.
COPY --from=build /workspace/build/install/*/ /app/
COPY --from=build /workspace/coral-agent.toml /app/coral-agent.toml

# Ensure a stable start-script name regardless of the generated applicationName
RUN set -eux; \
    script="$(ls -1 /app/bin/* | grep -v '\.bat$' | head -n 1)"; \
    ln -sf "$script" /app/bin/agent

# Use an unprivileged user
RUN useradd -r -u 1001 -g root appuser \
    && chown -R appuser:root /app
USER appuser

ENTRYPOINT ["/app/bin/agent"]
